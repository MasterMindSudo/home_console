{
  "name": "household-transit-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Local household commute dashboard for Hong Kong transit, driving ETA, and future reminders.",
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "ts-node-dev --respawn --transpile-only server/src/index.ts",
    "dev:client": "vite --host 0.0.0.0 --config client/vite.config.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "vite build --config client/vite.config.ts",
    "start": "node dist/server/server/src/index.js",
    "migrate:profiles:supabase": "node scripts/migrate-profiles-to-supabase.js",
    "test": "npm run build:server && node server/test/time.test.js && node server/test/busDirection.test.js && node server/test/trafficFlow.test.js && node server/test/tomtom.test.js && node server/test/profilesSupabase.test.js && node server/test/databaseMode.test.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "7.0.0",
    "@supabase/server": "^1.1.0",
    "@supabase/supabase-js": "^2.108.2",
    "@vitejs/plugin-react": "1.3.2",
    "better-sqlite3": "^11.10.0",
    "dotenv": "16.4.7",
    "fastify": "3.29.5",
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "node-fetch": "2.7.0",
    "pg": "8.13.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "vite": "2.9.16",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.11",
    "@types/leaflet": "1.9.16",
    "@types/node": "16.18.126",
    "@types/node-fetch": "2.6.12",
    "@types/pg": "^8.11.10",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@types/ws": "^8.18.1",
    "npm-run-all": "4.1.5",
    "ts-node-dev": "2.0.0",
    "typescript": "4.9.5"
  },
  "engines": {
    "node": "20.x"
  }
}
